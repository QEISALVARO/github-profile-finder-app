# Gitscope — environment variables (public, no secrets).
#
# Copy to `.env` and adjust. Files `.env` / `.env*.local` are git-ignored;
# only this template is committed.
#
# EXPO_PUBLIC_* values are inlined into the client bundle at build time —
# never put a service key, secret or private token here.

# --- Supabase (dipakai hanya saat flag domain = api) -------------------------
# Klien dibuat malas: kosong = tidak ada klien, mode mock tetap jalan.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Data source per domain: mock (default) | api ---------------------------
EXPO_PUBLIC_DS_AUTH=mock
EXPO_PUBLIC_DS_FEED=mock
EXPO_PUBLIC_DS_ANALYSIS=mock
EXPO_PUBLIC_DS_TALENT=mock
EXPO_PUBLIC_DS_CHAT=mock
EXPO_PUBLIC_DS_REPORTS=mock
