# ==============================================================================
# GITSCOPE — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Gunakan file ini sebagai acuan untuk membuat file `.env` di lokal Anda.
# Jalankan perintah: cp .env.example .env
#
# PENTING:
# 1. Jangan pernah meng-commit file `.env` ke Git!
# 2. JANGAN PERNAH menyematkan `SUPABASE_SERVICE_ROLE_KEY` ke dalam kode klien (`src/`).
#    Kunci service_role HANYA untuk skrip admin, CI, dan Edge Functions serverless.
# ==============================================================================
#
# Nilai aktual (bukan contoh) didapat dari `supabase status` setelah
# `supabase start` — jangan menebak atau memakai ulang nilai di bawah ini.

# ──────────────────────────────────────────────────────────────────────────────
# BACKEND (Supabase lokal & Edge Functions — JANGAN dibundle ke aplikasi)
# ──────────────────────────────────────────────────────────────────────────────
# URL endpoint lokal Supabase (default port: 54321)
SUPABASE_URL=http://127.0.0.1:54321

# Kunci anon lokal — tampilkan via `supabase status`, salin ke sini dan ke
# EXPO_PUBLIC_SUPABASE_ANON_KEY di bawah. Aman dipakai mobile app (RLS).
SUPABASE_ANON_KEY=<salin dari 'supabase status'>

# Kunci service_role lokal — tampilkan via `supabase status`.
# PERINGATAN: mem-bypass seluruh aturan Row Level Security (RLS).
# Hanya untuk skrip admin/CI/Edge Functions. Tanpa nilai = wajib diisi lokal.
SUPABASE_SERVICE_ROLE_KEY=<salin dari 'supabase status'>

# Port Database Postgres lokal
POSTGRES_PORT=54322
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# URL Supabase Studio lokal (Dashboard Database)
# Akses melalui browser: http://127.0.0.1:54323
SUPABASE_STUDIO_PORT=54323

# ──────────────────────────────────────────────────────────────────────────────
# GITHUB OAUTH PROVIDER (Autentikasi Pengguna)
# ──────────────────────────────────────────────────────────────────────────────
# Diperlukan untuk alur login pengguna developer & recruiter.
# Buat OAuth App baru di: https://github.com/settings/developers
# - Homepage URL: http://localhost:54321
# - Authorization callback URL: http://127.0.0.1:54321/auth/v1/callback
GITHUB_CLIENT_ID=<github-oauth-client-id>
GITHUB_CLIENT_SECRET=<github-oauth-client-secret>

# ──────────────────────────────────────────────────────────────────────────────
# GITHUB API TOKEN (Fase BE-2 — Ingestion & Scoring Engine)
# ──────────────────────────────────────────────────────────────────────────────
# Token GitHub Personal Access Token (PAT) atau GitHub App token.
# Digunakan oleh backend/Edge Function untuk mengambil repositori & profil.
# Scope minimal: read:user, public_repo
GITHUB_API_TOKEN=<github-personal-access-token>

# ──────────────────────────────────────────────────────────────────────────────
# FRONTEND / EXPO MOBILE APPLICATION (src/)
# ──────────────────────────────────────────────────────────────────────────────
# Variabel dengan prefix `EXPO_PUBLIC_` dapat diakses langsung oleh runtime Expo.
# Untuk pengujian di simulator / web lokal — samakan dengan nilai backend di atas.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<salin dari 'supabase status'>
