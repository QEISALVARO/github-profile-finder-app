# ==============================================================================
# GITSCOPE — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Gunakan file ini sebagai acuan untuk membuat file `.env` di lokal Anda.
# Jalankan perintah: cp .env.example .env
#
# PENTING:
# 1. Jangan pernah meng-commit file `.env` ke Git!
# 2. JANGAN PERNAH menyematkan `SUPABASE_SERVICE_ROLE_KEY` ke dalam kode klien (`src/`).
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. SUPABASE LOCAL DEVELOPMENT (Backend & Edge Functions)
# ──────────────────────────────────────────────────────────────────────────────
# URL endpoint lokal Supabase (default port: 54321)
SUPABASE_URL=http://127.0.0.1:54321

# Kunci anon bawaan Supabase local development (aman digunakan oleh frontend/mobile)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4Nzk2MDB9.CRX1AONv_tCHvd_y_pX_p6_w_fFqM4Yv6b_v_test

# Kunci service_role lokal (HANYA untuk skrip admin, CI, dan Edge Functions serverless)
# PERINGATAN: Kunci ini mem-bypass seluruh aturan Row Level Security (RLS).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4Mzg3OTYwMH0.dummy_service_role_key_for_dev

# Port Database Postgres lokal
POSTGRES_PORT=54322
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# URL Supabase Studio lokal (Dashboard Database)
# Akses melalui browser: http://127.0.0.1:54323
SUPABASE_STUDIO_PORT=54323

# ──────────────────────────────────────────────────────────────────────────────
# 2. GITHUB OAUTH PROVIDER (Autentikasi Pengguna)
# ──────────────────────────────────────────────────────────────────────────────
# Diperlukan untuk alur login pengguna developer & recruiter.
# Buat OAuth App baru di: https://github.com/settings/developers
# - Homepage URL: http://localhost:54321
# - Authorization callback URL: http://127.0.0.1:54321/auth/v1/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ──────────────────────────────────────────────────────────────────────────────
# 3. GITHUB API TOKEN (Fase BE-2 — Ingestion & Scoring Engine)
# ──────────────────────────────────────────────────────────────────────────────
# Token GitHub Personal Access Token (PAT) atau GitHub App token
# Digunakan oleh backend/Edge Function untuk mengambil repositori & profil
# Scope minimal: read:user, public_repo
GITHUB_API_TOKEN=ghp_your_github_personal_access_token_here

# ──────────────────────────────────────────────────────────────────────────────
# 4. FRONTEND / EXPO MOBILE APPLICATION (src/)
# ──────────────────────────────────────────────────────────────────────────────
# Variabel dengan prefix `EXPO_PUBLIC_` dapat diakses langsung oleh runtime Expo.
# Untuk pengujian di simulator / web lokal:
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4Nzk2MDB9.CRX1AONv_tCHvd_y_pX_p6_w_fFqM4Yv6b_v_test
